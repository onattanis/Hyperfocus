# Optional settings for running Hyperfocus with Node (local or on your own server).
# Copy this file to server/.env and change what you need. Everything has a sensible default.

# Asked for when the account is created. Set it if other people can reach your server.
# SETUP_TOKEN=pick-a-long-random-code

# Signs the sign-in cookie (at least 32 characters). If unset, a random one is created in the data folder.
# SESSION_SECRET=

# Where the database and uploaded files are kept (default: server/data).
# DATA_DIR=/var/lib/hyperfocus

# Port for `npm start` (production). In development the API listens on API_PORT and the app on 5173.
# PORT=3000
# API_PORT=8787

# Listen address for `npm start` (default 0.0.0.0, every network interface). Use 127.0.0.1 to keep it on this computer.
# HOST=0.0.0.0

# Set to 1 behind a reverse proxy (nginx, Caddy…) so rate limits see the visitor's real IP.
# TRUST_PROXY=1

# Use a remote libSQL / Turso database instead of the local SQLite file.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
